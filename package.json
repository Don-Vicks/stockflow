{
  "name": "stockflow",
  "private": true,
  "version": "1.0.0",
  "description": "StockFlow — a financial operating layer for tokenized stocks on Solana (StockFi + StockPay + Flows + Portfolio Protection)",
  "workspaces": [
    "packages/*",
    "automation",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "anchor:deploy:devnet": "anchor deploy --provider.cluster devnet",
    "sdk:build": "npm run build -w packages/sdk",
    "test": "npm run test -w packages/sdk && npm run test -w automation",
    "automation:dev": "npm run dev -w automation",
    "app:dev": "npm run dev -w app",
    "dev": "concurrently \"npm:app:dev\" \"npm:automation:dev\""
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.2",
    "chai": "^4.4.1",
    "concurrently": "^8.2.2",
    "mocha": "^10.7.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@pythnetwork/price-service-client": "^1.11.0",
    "bn.js": "^5.2.5",
    "dotenv": "^17.4.2"
  }
}
