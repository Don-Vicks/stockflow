      "msg": "Trigger conditions for this Flow have not been met yet."
    },
    {
      "code": 6006,
      "name": "ExecutionTooSoon",
      "msg": "Minimum execution interval has not elapsed since the last run."
    },
    {
      "code": 6007,
      "name": "ProtectionActive",
      "msg": "Portfolio protection policy has paused discretionary spending."
    },
    {
      "code": 6008,
      "name": "MathOverflow",
      "msg": "Numeric overflow while evaluating Flow constraints."
    },
    {
      "code": 6009,
      "name": "NoCollateralForBorrow",
      "msg": "Cannot borrow against zero collateral value."
    },
    {
      "code": 6010,
      "name": "Unauthorized",
      "msg": "Only the Flow owner may perform this action."
    },
    {
      "code": 6011,
      "name": "UnsupportedSource",
      "msg": "Unsupported source configuration for this action."
    },
    {
      "code": 6012,
      "name": "FlowMustBePausedToClose",
      "msg": "Flow must be paused before it can be closed."
    },
    {
      "code": 6013,
      "name": "InvalidProtectionThresholds",
      "msg": "Resume threshold must be strictly less than the pause threshold."
    }
  ],
  "types": [
    {
      "name": "Action",
      "docs": [
        "WHAT the Flow does when triggered."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Pay",
            "fields": [
              {
                "name": "amount",
                "type": "u64"
              }
            ]
          },
          {
            "name": "Borrow",
            "fields": [
              {
                "name": "amount",
                "type": "u64"
              }
            ]
          },
          {
            "name": "Repay",
            "fields": [
              {
                "name": "amount",
                "type": "u64"
              }
            ]
          },
          {
            "name": "PauseSpending"
          }
        ]
      }
    },
    {
      "name": "Constraints",
      "docs": [
        "Guardrails the on-chain program enforces regardless of what the",
        "off-chain automation worker submits. This is what makes automation",
        "safe per PRD Goal 4.",
        "",
        "`destination` (stored on the Flow itself) is always enforced for Pay",
        "actions — there is no separate \"locked recipient\" field here, which",
        "previously meant the check only ran when a caller also set that field."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "max_amount",
            "docs": [
              "Hard ceiling on any single execution's amount (source-token smallest unit)."
            ],
            "type": "u64"
          },
          {
            "name": "max_ltv_bps",
            "docs": [
              "Hard ceiling on portfolio LTV (bps) after this Flow executes."
            ],
            "type": "u16"
          }
        ]
      }
    },
    {
      "name": "Flow",
      "docs": [
        "A Financial Flow: Trigger -> Action -> Source -> Constraints -> Destination.",
        "This is the single on-chain object the PRD calls \"the core primitive.\""
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "docs": [
              "Wallet that owns this Flow and the underlying vault."
            ],
            "type": "pubkey"
          },
          {
            "name": "flow_id",
            "docs": [
              "Monotonically increasing per-owner nonce used in the PDA seeds so",
              "one owner can have many Flows."
            ],
            "type": "u64"
          },
          {
            "name": "name",
            "docs": [
              "UTF-8 display name, right-padded with zeros (max 32 bytes).",
              "Shown in the Flows dashboard: \"Developer Payment\", \"Portfolio Protection\"."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "next_execution",
            "docs": [
              "Unix timestamp of the next scheduled execution. Set on create and",
              "after each successful execution. 0 = OnDemand / no schedule."
            ],
            "type": "i64"
          },
          {
            "name": "execution_count",
            "docs": [
              "Total number of successful executions since creation.",
              "Drives the activity-feed execution count shown in the UI."
            ],
            "type": "u64"
          },
          {
            "name": "trigger",
            "type": {
              "defined": {
                "name": "Trigger"
              }
            }
          },
          {
            "name": "action",
            "type": {
              "defined": {
                "name": "Action"
              }
            }
          },
          {
            "name": "source",
            "type": {
              "defined": {
                "name": "Source"
              }
            }
          },
          {
            "name": "constraints",
            "type": {
              "defined": {
                "name": "Constraints"
              }
            }
          },
          {
            "name": "destination",
            "docs": [
              "Recipient wallet for Pay actions.",
              "Ignored for Borrow / Repay / PauseSpending."
            ],
            "type": "pubkey"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "FlowStatus"
              }
            }
          },
          {
            "name": "last_executed_at",
            "type": "i64"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "FlowStatus",
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Active"
          },
          {
            "name": "Paused"
          }
        ]
      }
    },
    {
      "name": "ProtectionPolicy",
      "docs": [
        "One per owner. Independent of individual Flows — this is the",
        "account the \"Portfolio Intelligence & Protection\" pillar reads",
        "and writes. When `spending_paused` is true, `execute_flow` refuses",
        "to run any Action::Pay or Action::Borrow across ALL of the owner's",
        "Flows until protection is cleared or a Repay brings LTV back down."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "pause_threshold_bps",
            "docs": [
              "LTV (bps) at which discretionary spending is auto-paused."
            ],
            "type": "u16"
          },
          {
            "name": "resume_threshold_bps",
            "docs": [
              "LTV (bps) at which spending is auto re-enabled after having",
              "been paused (hysteresis, so it doesn't flap at the boundary)."
            ],
            "type": "u16"
          },
          {
            "name": "spending_paused",
            "type": "bool"
          },
          {
            "name": "updated_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Source",
      "docs": [
        "WHERE the funds for a Pay action come from, in priority order."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "StablecoinOnly"
          },
          {
            "name": "StablecoinThenBorrow",
            "fields": [
              {
                "name": "collateral_mint",
                "type": "pubkey"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Trigger",
      "docs": [
        "WHEN a Flow is allowed to run."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "TimeInterval",
            "fields": [
              {
                "name": "interval_seconds",
                "type": "i64"
              }
            ]
          },
          {
            "name": "OnDemand"
          },
          {
            "name": "RiskThreshold",
            "fields": [
              {
                "name": "ltv_bps",
                "type": "u16"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "Vault",
      "docs": [
        "Policy Vault — a PDA-controlled token custodian, one per owner.",
        "",
        "Holds the owner's tokenized stocks and USDC so the program can sign",
        "token transfers on their behalf via the `vault_authority` PDA. This",
        "is the \"smart-contract-controlled account\" the PRD (§8.5) describes:",
        "",
        "\"A Policy Vault prevents the automation layer from having",
        "unrestricted custody.\"",
        "",
        "User flow: initialize_vault → deposit → create_flow → execute_flow."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "vault_authority",
            "docs": [
              "PDA that is set as the SPL token authority for all vault token",
              "accounts. Seeds: [VAULT_AUTHORITY_SEED, owner]. The program uses",
              "this PDA to sign transfers in execute_flow so the automation",
              "worker never holds direct authority over user assets."
            ],
            "type": "pubkey"
          },
          {
            "name": "vault_authority_bump",
            "type": "u8"
          },
          {
            "name": "keeper",
            "docs": [
              "Pubkey of the registered automation keeper (e.g. the off-chain",
              "worker's keypair, or a Tuk Tuk task signer). Stored here so",
              "execute_flow can verify: caller == owner OR caller == keeper.",
              "The owner can update this via update_vault_keeper."
            ],
            "type": "pubkey"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    }
  ]
}